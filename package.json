{
  "name": "genthaiid",
  "version": "2.1.0",
  "description": "better thaiid",
  "type": "module",
  "main": "index.js",
  "unpkg": "dist/genthaiid.min.js",
  "jsdelivr": "dist/genthaiid.min.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "npm run build:js && npm run build:min",
    "build:js": "esbuild index.js --bundle --format=iife --global-name=genthaiid --target=es2017 --outfile=dist/genthaiid.js",
    "build:min": "esbuild index.js --bundle --format=iife --global-name=genthaiid --target=es2017 --minify --outfile=dist/genthaiid.min.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PingHuskar/genthaiid.git"
  },
  "keywords": [
    "thaiid",
    "thai-id",
    "thai-id-generator",
    "thai",
    "id",
    "thai id",
    "nationality",
    "nationality id",
    "validation",
    "validator",
    "personal id",
    "PID",
    "random",
    "card",
    "generate",
    "verify"
  ],
  "author": "Chadin Chaipornpisuth",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "operation-strint": "^1.0.9"
  }
}
